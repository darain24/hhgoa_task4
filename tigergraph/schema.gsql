// Trace fraud-investigation graph. Verified against TigerGraph 4.2.5 Community Edition.
// Non-destructive: no DROP statements. Attribute `proxy_rating` avoids a GSQL parser
// conflict with the bare name `proxy` inside a long attribute list.
CREATE VERTEX Customer (PRIMARY_ID id STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX Card (PRIMARY_ID id STRING, customer_id STRING, verified BOOL) WITH primary_id_as_attribute="true"
CREATE VERTEX Transaction (PRIMARY_ID id STRING, customer_id STRING, card_id STRING, ts STRING, amount DOUBLE, channel STRING, risk DOUBLE, region STRING, country STRING, product STRING, email STRING, recipient STRING, device STRING, new_device STRING, proxy_rating STRING, match_flags STRING, card_verified BOOL) WITH primary_id_as_attribute="true"
CREATE VERTEX DeviceProfile (PRIMARY_ID id STRING, description STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX BillingRegion (PRIMARY_ID id STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX EmailDomain (PRIMARY_ID id STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX ClosedCase (PRIMARY_ID id STRING, customer_id STRING, card_id STRING, opened_at STRING, closed_at STRING, outcome STRING, pattern STRING, txn_ids STRING, exposure DOUBLE, notes STRING) WITH primary_id_as_attribute="true"
// Case memory. Attributes are queryable so a later investigation can retrieve prior
// findings by customer, card, pattern or device without parsing the archived payload.
CREATE VERTEX Investigation (PRIMARY_ID id STRING, customer_id STRING, card_id STRING, opened_at STRING, status STRING, verdict STRING, pattern STRING, fraud_probability DOUBLE, exposure DOUBLE, actions STRING, sar_filed BOOL, summary STRING, payload STRING, outcome_verified BOOL) WITH primary_id_as_attribute="true"
CREATE VERTEX Document (PRIMARY_ID id STRING, text STRING, kind STRING, closed_at STRING) WITH primary_id_as_attribute="true"
CREATE DIRECTED EDGE OWNS (FROM Customer, TO Card) WITH REVERSE_EDGE="OWNED_BY"
CREATE DIRECTED EDGE MADE (FROM Card, TO Transaction) WITH REVERSE_EDGE="ON_CARD"
CREATE DIRECTED EDGE FROM_DEVICE (FROM Transaction, TO DeviceProfile) WITH REVERSE_EDGE="DEVICE_TXNS"
CREATE DIRECTED EDGE BILLED_IN (FROM Transaction, TO BillingRegion) WITH REVERSE_EDGE="REGION_TXNS"
CREATE DIRECTED EDGE PURCHASER_EMAIL (FROM Transaction, TO EmailDomain) WITH REVERSE_EDGE="EMAIL_TXNS"
CREATE DIRECTED EDGE INVOLVES (FROM ClosedCase, TO Transaction) WITH REVERSE_EDGE="CASE_FOR"
CREATE DIRECTED EDGE CASE_ON_CARD (FROM ClosedCase, TO Card) WITH REVERSE_EDGE="CARD_CASES"
CREATE DIRECTED EDGE FINDING (FROM Investigation, TO Transaction) WITH REVERSE_EDGE="FOUND_BY"
CREATE DIRECTED EDGE INVESTIGATES (FROM Investigation, TO Card) WITH REVERSE_EDGE="CARD_INVESTIGATIONS"
CREATE DIRECTED EDGE CONNECTED_TO (FROM Investigation, TO Card) WITH REVERSE_EDGE="LINKED_INVESTIGATIONS"
CREATE DIRECTED EDGE SEEN_ON (FROM Investigation, TO DeviceProfile) WITH REVERSE_EDGE="DEVICE_INVESTIGATIONS"
CREATE DIRECTED EDGE CITES (FROM Investigation, TO ClosedCase) WITH REVERSE_EDGE="CITED_BY"
CREATE DIRECTED EDGE NEXT (FROM Transaction, TO Transaction) WITH REVERSE_EDGE="PREVIOUS"
CREATE GRAPH Trace (Customer,Card,Transaction,DeviceProfile,BillingRegion,EmailDomain,ClosedCase,Investigation,Document,OWNS,MADE,FROM_DEVICE,BILLED_IN,PURCHASER_EMAIL,INVOLVES,CASE_ON_CARD,FINDING,INVESTIGATES,CONNECTED_TO,SEEN_ON,CITES,NEXT)
