// Review on your TigerGraph 4.2+ workspace. Non-destructive: no DROP statements.
CREATE VERTEX Customer (PRIMARY_ID id STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX Card (PRIMARY_ID id STRING, verified BOOL) WITH primary_id_as_attribute="true"
CREATE VERTEX Transaction (PRIMARY_ID id STRING, customer_id STRING, card_id STRING, ts STRING, amount DOUBLE, channel STRING, risk DOUBLE, region STRING, country STRING, product STRING, email STRING, recipient STRING, device STRING, new_device STRING, proxy STRING, match_flags STRING, card_verified BOOL) WITH primary_id_as_attribute="true"
CREATE VERTEX DeviceProfile (PRIMARY_ID id STRING, description STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX BillingRegion (PRIMARY_ID id STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX EmailDomain (PRIMARY_ID id STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX ClosedCase (PRIMARY_ID id STRING, customer_id STRING, card_id STRING, opened_at STRING, closed_at STRING, outcome STRING, pattern STRING, txn_ids STRING, exposure DOUBLE, notes STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX Investigation (PRIMARY_ID id STRING, payload STRING, outcome_verified BOOL) WITH primary_id_as_attribute="true"
CREATE VERTEX Document (PRIMARY_ID id STRING, text STRING, kind STRING, closed_at STRING) WITH primary_id_as_attribute="true"
CREATE DIRECTED EDGE OWNS (FROM Customer, TO Card) WITH REVERSE_EDGE="OWNED_BY"
CREATE DIRECTED EDGE MADE (FROM Card, TO Transaction) WITH REVERSE_EDGE="ON_CARD"
CREATE DIRECTED EDGE FROM_DEVICE (FROM Transaction, TO DeviceProfile) WITH REVERSE_EDGE="DEVICE_TXNS"
CREATE DIRECTED EDGE BILLED_IN (FROM Transaction, TO BillingRegion) WITH REVERSE_EDGE="REGION_TXNS"
CREATE DIRECTED EDGE PURCHASER_EMAIL (FROM Transaction, TO EmailDomain)
CREATE DIRECTED EDGE INVOLVES (FROM ClosedCase, TO Transaction) WITH REVERSE_EDGE="CASE_FOR"
CREATE DIRECTED EDGE FINDING (FROM Investigation, TO Transaction)
CREATE DIRECTED EDGE NEXT (FROM Transaction, TO Transaction)
CREATE GRAPH Trace (Customer,Card,Transaction,DeviceProfile,BillingRegion,EmailDomain,ClosedCase,Investigation,Document,OWNS,MADE,FROM_DEVICE,BILLED_IN,PURCHASER_EMAIL,INVOLVES,FINDING,NEXT)
