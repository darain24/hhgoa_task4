# All inference runs locally. No paid API keys are accepted.
TRACE_MODEL=qwen3:4b
# Optional local data directory override:
# TRACE_DATA_DIR=/absolute/path/to/data
# Connect only to a verified no-charge TigerGraph workspace.
# Run the official MCP server locally; keep credentials in this file, never Git.
TG_MCP_URL=
TG_GRAPH=Trace
TG_HOST=
TG_GRAPHNAME=Trace
TG_API_TOKEN=
# Actual service token setup may additionally require TG_RESTPP_PORT / TG_GS_PORT.
